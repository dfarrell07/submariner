# NOTE: This file points to the official Red Hat Enterprise Linux 9 repositories.
# Access requires a valid Red Hat subscription and entitlement certificates.
#
# The tool running this (rpm-lockfile-prototype) must have access to your
# entitlement certificates at the paths specified by 'sslclientcert' and
# 'sslclientkey' below. If you are running the tool in a container, you may
# need to mount your host's /etc/pki/entitlement directory.

# x86_64: Using GA (dist) repositories - fully supported
[rhel-9-for-x86_64-baseos-rpms]
name = Red Hat Enterprise Linux 9 for x86_64 - BaseOS (RPMs)
baseurl = https://cdn.redhat.com/content/dist/rhel9/9/x86_64/baseos/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientcert = /etc/pki/entitlement/2713869142313201886.pem
sslclientkey = /etc/pki/entitlement/2713869142313201886-key.pem

[rhel-9-for-x86_64-appstream-rpms]
name = Red Hat Enterprise Linux 9 for x86_64 - AppStream (RPMs)
baseurl = https://cdn.redhat.com/content/dist/rhel9/9/x86_64/appstream/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientcert = /etc/pki/entitlement/2713869142313201886.pem
sslclientkey = /etc/pki/entitlement/2713869142313201886-key.pem

[codeready-builder-for-rhel-9-x86_64-rpms]
name = Red Hat CodeReady Linux Builder for RHEL 9 x86_64 (RPMs)
baseurl = https://cdn.redhat.com/content/dist/rhel9/9/x86_64/codeready-builder/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientcert = /etc/pki/entitlement/2713869142313201886.pem
sslclientkey = /etc/pki/entitlement/2713869142313201886-key.pem

